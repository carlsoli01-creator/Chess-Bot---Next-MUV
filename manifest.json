{
  "manifest_version": 3,
  "name": "Chess Move Predictor",
  "version": "1.0",
  "description": "Predicts the best next move for the bottom player on chess.com based on real engine analysis.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_permissions": ["camera"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.chess.com/*"],
      "js": ["dist/contentScript.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
