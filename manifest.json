{
  "manifest_version": 3,
  "name": "Chess Move Predictor",
  "version": "1.0",
  "description": "Stockfish-powered move suggestions for chess.com — live overlay shows your best next move.",
  "permissions": ["activeTab", "scripting"],
  "optional_permissions": ["camera"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.chess.com/*"],
      "js": ["dist/contentScript.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/stockfish-18-lite-single.js",
        "dist/stockfish-18-lite-single.wasm"
      ],
      "matches": ["*://www.chess.com/*"]
    }
  ]
}
